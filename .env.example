NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_PATH=./database/movie_platform.sqlite
DATABASE_WAL_MODE=true

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=id-ID
TMDB_CACHE_TTL_DAYS=7
TMDB_REQUEST_TIMEOUT_MS=10000

# Generate a unique 32-byte secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DEFAULT_DAYS=1
REFRESH_TOKEN_TTL_REMEMBER_DAYS=30

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50

MOST_WATCHED_LIMIT=20
MOST_WATCHED_MIN_RECORDS=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Comma-separated exact origins. Outside production, local HTTP loopback origins
# (including Swagger Preview's temporary localhost port) are also accepted.
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=debug
