meta {
  name: Get Profile Movies
  type: http
  seq: 2
}

get {
  url: http://{{apiHost}}:{{apiPort}}{{apiPrefix}}/profiles/{{publicId}}/movies
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  status: {{status}}
  page: {{page}}
  limit: {{limit}}
}

headers {
  Accept: application/json
}
