meta {
  name: Get Current User
  type: http
  seq: 5
}

get {
  url: {{apiHost}}{{apiPort}}{{apiPrefix}}/auth/current-user
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Run Login first to populate the accessToken runtime variable.
}
