meta {
  name: Register Account
  type: http
  seq: 1
}

post {
  url: {{apiHost}}{{apiPort}}{{apiPrefix}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{registerEmail}}",
    "password": "{{registerPassword}}",
    "displayName": "{{displayName}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body?.data?.user?.publicId) {
    bru.setVar('publicId', res.body.data.user.publicId);
  }
}

docs {
  Run once for a new test email. The publicId is saved as a Bruno runtime variable for the profile requests.
}
